{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/black-friday", "destination": "/#coleccion", "permanent": true },
    { "source": "/vestidos", "destination": "/#coleccion", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
