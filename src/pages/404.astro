---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada | CÀROM Studio" description="Esta página no existe. Descubre nuestros vestidos vintage para bodas e invitadas." noindex>
  <section class="contenedor py-28 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-5xl sm:text-6xl">Este vestido se nos ha perdido</h1>
    <p class="mx-auto mt-5 max-w-md text-cacao-suave">La página que buscas no existe, pero tenemos muchos otros esperándote.</p>
    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/vestidos" class="btn-primario">Ver vestidos</a>
      <a href="/" class="btn-secundario">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
