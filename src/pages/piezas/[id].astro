---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, contactoLink } from '../../data/site';
import {
  blackFriday as bf,
  getVestido,
  vestidos,
  descuentoDe,
  formatoPrecio,
  imagenPrincipal,
  esVideo,
} from '../../data/blackfriday';

export function getStaticPaths() {
  return vestidos.map((v) => ({ params: { id: v.id } }));
}

const { id } = Astro.params;
const v = getVestido(id!);
if (!v) return Astro.redirect('/#coleccion');

const disponible = v.estado === 'disponible';
const descuento = descuentoDe(v);
const fotoPrincipal = imagenPrincipal(v);
const base = Astro.site ?? new URL(site.url);
const url = new URL(`/piezas/${v.id}`, base).href;
const abs = (ruta: string) => new URL(ruta, base).href;

const schemaProducto = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: v.nombre,
  description: v.descripcion || `${v.nombre}: pieza vintage única de Càrom Studio Vintage.`,
  image: v.imagenes.filter((ruta) => !esVideo(ruta)).map(abs),
  brand: { '@type': 'Brand', name: site.nombre },
  ...(v.talla && { size: v.talla }),
  ...(v.precio !== null && {
    offers: {
      '@type': 'Offer',
      price: v.precio.toFixed(2),
      priceCurrency: 'EUR',
      availability:
        v.estado === 'disponible'
          ? 'https://schema.org/InStock'
          : v.estado === 'reservado'
            ? 'https://schema.org/LimitedAvailability'
            : 'https://schema.org/SoldOut',
      url,
      itemCondition: 'https://schema.org/UsedCondition',
    },
  }),
};
---
<BaseLayout
  title={`${v.nombre} | ${site.nombre}`}
  description={v.descripcion || `${v.nombre}: pieza vintage única. Talla y medidas en la ficha. Escríbenos por Instagram.`}
  ogImage={fotoPrincipal || site.ogImagePorDefecto}
  ogImageAlt={v.alt}
  preloadImage={fotoPrincipal || undefined}
  schemas={[schemaProducto]}
>
  <article class="contenedor py-12 sm:py-20">
    <nav aria-label="Migas de pan" class="etiqueta mb-10 text-oliva/70">
      <a href="/#coleccion" class="transition-colors hover:text-oliva">Selección</a>
      <span aria-hidden="true"> · </span>
      <span aria-current="page">{v.nombre}</span>
    </nav>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- GALERÍA -->
      <div class="lg:col-span-7">
        {v.imagenes.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2" data-galeria>
            {v.imagenes.map((src, i) =>
              esVideo(src) ? (
                <button
                  type="button"
                  class:list={[
                    'group relative block aspect-[3/4] w-full overflow-hidden bg-noche text-left',
                    i === 0 && 'sm:col-span-2',
                  ]}
                  data-galeria-item
                  data-galeria-index={i}
                  data-galeria-tipo="video"
                  data-galeria-src={src}
                  aria-label={`Ampliar vídeo ${i + 1} de ${v.imagenes.length}`}
                >
                  <video
                    src={src}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                    data-galeria-video
                    class:list={[
                      'h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]',
                      !disponible && 'opacity-50 grayscale',
                    ]}
                  />
                </button>
              ) : (
                <button
                  type="button"
                  class:list={[
                    'group relative block aspect-[3/4] w-full overflow-hidden bg-noche text-left',
                    i === 0 && 'sm:col-span-2',
                  ]}
                  data-galeria-item
                  data-galeria-index={i}
                  data-galeria-tipo="imagen"
                  data-galeria-src={src}
                  aria-label={`Ampliar foto ${i + 1} de ${v.imagenes.length}`}
                >
                  <img
                    src={src}
                    alt={`${v.alt}${v.imagenes.length > 1 ? `, foto ${i + 1}` : ''}`}
                    width="900"
                    height="1200"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={i === 0 ? 'high' : undefined}
                    class:list={[
                      'h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]',
                      !disponible && 'opacity-50 grayscale',
                    ]}
                  />
                </button>
              )
            )}
          </div>
        ) : (
          <div class="flex aspect-[3/4] items-center justify-center bg-lino sm:aspect-[4/5]">
            <p class="etiqueta text-center text-oliva">Fotos pendientes<br /><span class="mt-2 block normal-case tracking-normal opacity-70">Las añadiremos en cuanto las tengamos</span></p>
          </div>
        )}
      </div>

      <!-- FICHA -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
        <p class="etiqueta text-oliva">Pieza única{bf.activo && ' · The Private Edit'}</p>
        <h1 class="mt-5 text-5xl text-oliva sm:text-6xl">{v.nombre}</h1>

        {!disponible && (
          <p class="etiqueta mt-6 text-oliva/70">
            {v.estado === 'reservado' ? 'Reservado' : 'Ha encontrado dueña'}
          </p>
        )}

        {(v.precio !== null || descuento !== null) && (
          <div class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
            {descuento !== null && (
              <p class="bg-oliva px-2.5 py-1.5 text-[0.68rem] tracking-[0.2em] text-crema uppercase">
                −{descuento} %
              </p>
            )}
            {v.precio !== null && (
              <p class="font-serif text-3xl text-oliva">{formatoPrecio(v.precio)}</p>
            )}
          </div>
        )}

        <dl class="mt-10 space-y-5 border-y border-noche/15 py-8">
          <div>
            <dt class="etiqueta text-oliva">Talla</dt>
            <dd class="mt-2 font-serif text-2xl text-oliva">{v.talla || 'Pendiente'}</dd>
          </div>
          <div>
            <dt class="etiqueta text-oliva">Medidas</dt>
            <dd class="mt-2 whitespace-pre-line text-oliva/80">{v.medidas || 'Pendientes de confirmar'}</dd>
          </div>
        </dl>

        {v.descripcion && <p class="mt-8 text-oliva/80">{v.descripcion}</p>}

        {disponible ? (
          <a
            href={contactoLink()}
            target="_blank"
            rel="noopener"
            class="btn-oscuro mt-10 w-full sm:w-auto"
            data-umami-event="instagram-md-click"
            data-umami-event-origen="ficha"
            data-umami-event-vestido={v.nombre}
          >
            Lo quiero
          </a>
        ) : (
          <a href="/#coleccion" class="btn-oscuro mt-10 inline-flex">Ver otras piezas</a>
        )}

        <p class="mt-6 text-sm text-oliva/80">
          Escríbenos por Instagram indicando el nombre de la pieza
          {v.talla && <> y la talla {v.talla}</>}.
        </p>
      </div>
    </div>
  </article>

  {v.imagenes.length > 0 && (
    <div
      id="lightbox"
      class="fixed inset-0 z-[80] hidden items-center justify-center bg-noche/92 p-4 sm:p-8"
      role="dialog"
      aria-modal="true"
      aria-label={`Galería de ${v.nombre}`}
      hidden
    >
      <button
        type="button"
        data-lightbox-cerrar
        class="absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center text-crema/70 transition hover:text-crema sm:top-6 sm:right-6"
        aria-label="Cerrar galería"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      {v.imagenes.length > 1 && (
        <>
          <button
            type="button"
            data-lightbox-prev
            class="absolute top-1/2 left-2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center text-crema/70 transition hover:text-crema sm:left-5"
            aria-label="Foto anterior"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
              <path d="M15 5l-7 7 7 7"></path>
            </svg>
          </button>
          <button
            type="button"
            data-lightbox-next
            class="absolute top-1/2 right-2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center text-crema/70 transition hover:text-crema sm:right-5"
            aria-label="Foto siguiente"
          >
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
              <path d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </>
      )}

      <div class="flex h-full w-full items-center justify-center px-12 py-14 sm:px-16" data-lightbox-escena>
        <img
          data-lightbox-img
          class="hidden h-auto max-h-[min(88vh,100%)] w-auto max-w-full object-contain"
          alt=""
        />
        <video
          data-lightbox-video
          class="hidden h-auto max-h-[min(88vh,100%)] w-auto max-w-full object-contain"
          controls
          playsinline
        ></video>
      </div>

      {v.imagenes.length > 1 && (
        <p class="etiqueta absolute bottom-5 left-1/2 -translate-x-1/2 text-crema/55" data-lightbox-contador aria-live="polite"></p>
      )}
    </div>
  )}

  <script>
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-galeria-video]');
    if (videos.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            const video = e.target as HTMLVideoElement;
            if (e.isIntersecting) void video.play().catch(() => {});
            else video.pause();
          }
        },
        { threshold: 0.35 },
      );
      videos.forEach((v) => io.observe(v));
    }

    const lightbox = document.getElementById('lightbox');
    const items = [...document.querySelectorAll<HTMLElement>('[data-galeria-item]')];
    if (lightbox && items.length) {
      const imgEl = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const videoEl = lightbox.querySelector<HTMLVideoElement>('[data-lightbox-video]');
      const contador = lightbox.querySelector<HTMLElement>('[data-lightbox-contador]');
      const btnCerrar = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-cerrar]');
      const btnPrev = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
      const btnNext = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]');
      let indice = 0;
      let ultimoFoco: HTMLElement | null = null;

      const pieza = (i: number) => {
        const el = items[i];
        return {
          src: el.dataset.galeriaSrc || '',
          tipo: el.dataset.galeriaTipo || 'imagen',
          alt: el.querySelector('img')?.alt || '',
        };
      };

      const mostrar = (i: number) => {
        indice = (i + items.length) % items.length;
        const actual = pieza(indice);
        if (imgEl && videoEl) {
          if (actual.tipo === 'video') {
            imgEl.classList.add('hidden');
            imgEl.removeAttribute('src');
            videoEl.classList.remove('hidden');
            videoEl.src = actual.src;
            void videoEl.play().catch(() => {});
          } else {
            videoEl.pause();
            videoEl.removeAttribute('src');
            videoEl.classList.add('hidden');
            imgEl.classList.remove('hidden');
            imgEl.src = actual.src;
            imgEl.alt = actual.alt;
          }
        }
        if (contador) contador.textContent = `${indice + 1} / ${items.length}`;
      };

      const abrir = (i: number) => {
        ultimoFoco = document.activeElement as HTMLElement | null;
        mostrar(i);
        lightbox.hidden = false;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.documentElement.style.overflow = 'hidden';
        btnCerrar?.focus();
      };

      const cerrar = () => {
        if (videoEl) {
          videoEl.pause();
          videoEl.removeAttribute('src');
        }
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        lightbox.hidden = true;
        document.documentElement.style.overflow = '';
        ultimoFoco?.focus();
      };

      items.forEach((el, i) => {
        el.addEventListener('click', () => abrir(i));
      });
      btnCerrar?.addEventListener('click', cerrar);
      btnPrev?.addEventListener('click', () => mostrar(indice - 1));
      btnNext?.addEventListener('click', () => mostrar(indice + 1));

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) cerrar();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') cerrar();
        if (e.key === 'ArrowLeft') mostrar(indice - 1);
        if (e.key === 'ArrowRight') mostrar(indice + 1);
      });
    }
  </script>
</BaseLayout>
