---
import BaseLayout from '../layouts/BaseLayout.astro';
import DressCard from '../components/DressCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { vestidos, blackFriday } from '../data/blackfriday';

const eventos = [
  { id: 'todos', texto: 'Todos' },
  { id: 'boda', texto: 'Boda' },
  { id: 'invitada', texto: 'Invitada' },
  { id: 'gala', texto: 'Gala' },
  { id: 'comunion', texto: 'Comunión' },
];
const tallas = [...new Set(vestidos.flatMap((v) => v.tallas))].sort((a, b) => Number(a) - Number(b));
---
<BaseLayout
  title="Vestidos vintage de invitada, boda y gala | CÀROM Studio"
  description="Catálogo de vestidos vintage para bodas, invitadas, galas y comuniones. Filtra por evento y talla, y pide el tuyo por WhatsApp. Envíos a toda España."
>
  <section class="contenedor pt-12 pb-10 text-center sm:pt-20">
    <p class="eyebrow">Catálogo</p>
    <h1 class="mt-3 text-5xl sm:text-6xl">Vestidos vintage para tus eventos</h1>
    <p class="mx-auto mt-5 max-w-xl text-cacao-suave">
      Cada vestido es una pieza única, revisada y lista para estrenar de nuevo. ¿Te gusta uno? Pulsa «Lo quiero» y nos escribes por WhatsApp.
    </p>
    {blackFriday.activo && (
      <p class="mt-6">
        <a href="/black-friday" class="inline-block rounded-full bg-cacao px-5 py-2 text-sm text-crema hover:bg-tierra-texto">
          Black Friday: −{blackFriday.descuento} % en vestidos seleccionados →
        </a>
      </p>
    )}
  </section>

  <section class="contenedor pb-24" aria-label="Catálogo de vestidos">
    <form id="filtros" class="sticky top-16 z-20 -mx-5 mb-10 flex flex-col gap-4 border-y border-cacao/10 bg-crema/95 px-5 py-4 backdrop-blur-sm sm:top-20 sm:mx-0 sm:flex-row sm:items-center sm:justify-between sm:rounded-full sm:border sm:px-6" onsubmit="return false">
      <fieldset class="flex flex-wrap gap-2">
        <legend class="sr-only">Filtrar por evento</legend>
        {eventos.map((e, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="evento" value={e.id} checked={i === 0} class="peer sr-only" />
            <span class="inline-block rounded-full border border-cacao/25 px-4 py-2 text-sm transition peer-checked:border-oliva peer-checked:bg-oliva peer-checked:text-crema-claro peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-tierra-texto hover:border-cacao/60">
              {e.texto}
            </span>
          </label>
        ))}
      </fieldset>
      <label class="flex items-center gap-3 text-sm">
        <span>Talla</span>
        <select name="talla" class="rounded-full border border-cacao/25 bg-crema-claro px-4 py-2 pr-8">
          <option value="">Todas</option>
          {tallas.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
    </form>

    <p id="contador" class="mb-6 text-sm text-cacao-suave" aria-live="polite">{vestidos.length} vestidos</p>

    <div id="catalogo" class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {vestidos.map((v) => <DressCard vestido={v} origen="catalogo" headingLevel="h2" />)}
    </div>

    <div id="sin-resultados" class="hidden py-16 text-center">
      <p class="font-serif text-3xl">Ahora mismo no tenemos ese vestido en tu talla</p>
      <p class="mt-3 text-cacao-suave">Escríbenos: entran piezas nuevas cada semana y te avisamos.</p>
      <WhatsAppButton origen="catalogo-sin-resultados" mensaje="Hola, busco un vestido en talla __ para __" class="mt-6" />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('filtros') as HTMLFormElement;
  const tarjetas = [...document.querySelectorAll<HTMLElement>('#catalogo .vestido')];
  const contador = document.getElementById('contador')!;
  const vacio = document.getElementById('sin-resultados')!;

  function aplicar() {
    const datos = new FormData(form);
    const evento = String(datos.get('evento') || 'todos');
    const talla = String(datos.get('talla') || '');
    let visibles = 0;

    for (const t of tarjetas) {
      const okEvento = evento === 'todos' || t.dataset.eventos!.split(' ').includes(evento);
      const okTalla = !talla || t.dataset.tallas!.split(' ').includes(talla);
      const mostrar = okEvento && okTalla;
      t.hidden = !mostrar;
      if (mostrar) visibles++;

      const boton = t.querySelector<HTMLAnchorElement>('.lo-quiero');
      if (boton) {
        const mensaje = `Hola, me interesa el vestido ${boton.dataset.nombre} en talla ${talla || '__'}`;
        boton.href = `${boton.href.split('?')[0]}?text=${encodeURIComponent(mensaje)}`;
      }
    }

    contador.textContent = `${visibles} ${visibles === 1 ? 'vestido' : 'vestidos'}`;
    vacio.classList.toggle('hidden', visibles > 0);

    const params = new URLSearchParams();
    if (evento !== 'todos') params.set('evento', evento);
    if (talla) params.set('talla', talla);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  const inicial = new URLSearchParams(location.search);
  const ev = inicial.get('evento');
  const ta = inicial.get('talla');
  if (ev) form.querySelector<HTMLInputElement>(`input[name="evento"][value="${CSS.escape(ev)}"]`)?.click();
  if (ta) (form.elements.namedItem('talla') as HTMLSelectElement).value = ta;

  form.addEventListener('change', aplicar);
  aplicar();
</script>
