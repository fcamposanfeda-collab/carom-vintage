---
import BaseLayout from '../layouts/BaseLayout.astro';
import DressCard from '../components/DressCard.astro';
import Countdown from '../components/Countdown.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import RegalaCarom from '../components/RegalaCarom.astro';
import IconInstagram from '../components/IconInstagram.astro';
import { site } from '../data/site';
import {
  blackFriday as bf,
  vestidos,
  enOferta,
  precioOferta,
  faqBlackFriday,
  textosBlackFriday as t,
} from '../data/blackfriday';

const base = Astro.site ?? new URL(site.url);
const url = new URL('/black-friday', base).href;
const abs = (ruta: string) => new URL(ruta, base).href;

const enPromo = vestidos.filter(enOferta);
const deInvitada = enPromo.filter((v) => v.eventos.includes('invitada'));
const deBoda = enPromo.filter((v) => !v.eventos.includes('invitada'));

const title = 'Black Friday vestidos vintage para bodas e invitadas | CÀROM Studio';
const description = `Black Friday en CÀROM Studio: −${bf.descuento} % en vestidos vintage de invitada, boda y gala ${bf.fechasTexto}. Envíos a toda España. Escríbenos por WhatsApp y reserva el tuyo.`;

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqBlackFriday.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const schemaSale = {
  '@context': 'https://schema.org',
  '@type': 'SaleEvent',
  name: `Black Friday CÀROM Studio: −${bf.descuento} % en vestidos vintage`,
  description,
  url,
  image: abs(bf.ogImage),
  startDate: bf.inicio,
  endDate: bf.fin,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: { '@type': 'VirtualLocation', url },
  organizer: { '@type': 'ClothingStore', '@id': `${base.origin}/#tienda`, name: site.nombre, url: base.origin },
  offers: enPromo.map((v) => ({
    '@type': 'Offer',
    name: v.nombre,
    url,
    price: precioOferta(v.precio).toFixed(2),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    validFrom: bf.inicio,
    priceValidUntil: bf.fin.slice(0, 10),
    priceSpecification: [
      { '@type': 'UnitPriceSpecification', price: precioOferta(v.precio).toFixed(2), priceCurrency: 'EUR' },
      {
        '@type': 'UnitPriceSpecification',
        priceType: 'https://schema.org/StrikethroughPrice',
        price: v.precio.toFixed(2),
        priceCurrency: 'EUR',
      },
    ],
    itemOffered: {
      '@type': 'Product',
      name: v.nombre,
      description: v.descripcion,
      image: abs(v.imagen),
      brand: { '@type': 'Brand', name: site.nombre },
    },
  })),
};

const schemaMigas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: base.origin },
    { '@type': 'ListItem', position: 2, name: 'Black Friday', item: url },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  ogImage={bf.ogImage}
  ogImageAlt={`Black Friday CÀROM Studio: −${bf.descuento} % en vestidos vintage para bodas e invitadas`}
  preloadImage={bf.imagen}
  schemas={[schemaSale, schemaFaq, schemaMigas]}
>
  <!-- HERO -->
  <section class="bg-cacao text-crema">
    <div class="contenedor grid items-center gap-10 py-12 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:py-20">
      <div>
        <nav aria-label="Migas de pan" class="mb-6 text-xs text-crema/80">
          <a href="/" class="hover:text-crema">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Black Friday</span>
        </nav>
        <p class="text-xs font-medium tracking-[0.3em] text-crema/80 uppercase">{bf.fechasTexto} · −{bf.descuento} %</p>
        <h1 class="mt-4 text-5xl text-crema sm:text-6xl lg:text-7xl">
          Black Friday de <span class="italic">vestidos vintage</span> para bodas e invitadas
        </h1>
        <p class="mt-6 max-w-lg text-lg text-crema/85">{t.intro}</p>

        <div class="mt-8">
          <p class="mb-3 text-sm text-crema/80">La promo termina en:</p>
          <Countdown fin={bf.fin} />
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <WhatsAppButton origen="black-friday-hero" mensaje={bf.mensajeWhatsapp} variante="claro">
            Pedir por WhatsApp
          </WhatsAppButton>
          <a href={site.instagramMD} target="_blank" rel="noopener" class="btn-linea-clara" data-umami-event="instagram-dm-click" data-umami-event-origen="black-friday-hero">
            <IconInstagram /> Escríbenos un MD
          </a>
        </div>
      </div>
      <img
        src={bf.imagen}
        alt={bf.imagenAlt}
        width="960"
        height="1200"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/5] w-full max-w-md rounded-sm object-cover md:max-w-none"
      />
    </div>
  </section>

  <!-- QUÉ INCLUYE -->
  <section class="py-16 sm:py-24" aria-labelledby="que-incluye">
    <div class="contenedor max-w-3xl">
      <h2 id="que-incluye" class="text-4xl sm:text-5xl">Qué incluye el Black Friday</h2>
      <ul class="mt-8 space-y-4">
        {t.queIncluye.map((item) => (
          <li class="flex gap-4">
            <span class="mt-3 h-px w-6 shrink-0 bg-tierra" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- INVITADA -->
  {deInvitada.length > 0 && (
    <section class="bg-crema-claro py-16 sm:py-24" aria-labelledby="invitada">
      <div class="contenedor">
        <h2 id="invitada" class="text-4xl sm:text-5xl">Vestidos de invitada rebajados</h2>
        <p class="mt-5 max-w-2xl text-cacao-suave">{t.invitada}</p>
        <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {deInvitada.map((v) => <DressCard vestido={v} origen="black-friday-invitada" />)}
        </div>
      </div>
    </section>
  )}

  <!-- BODA Y GALA -->
  {deBoda.length > 0 && (
    <section class="py-16 sm:py-24" aria-labelledby="boda">
      <div class="contenedor">
        <h2 id="boda" class="text-4xl sm:text-5xl">Vestidos de boda vintage en oferta</h2>
        <p class="mt-5 max-w-2xl text-cacao-suave">{t.boda}</p>
        <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {deBoda.map((v) => <DressCard vestido={v} origen="black-friday-boda" />)}
        </div>
      </div>
    </section>
  )}

  <!-- CÓMO PEDIR + ENVÍOS -->
  <section class="bg-oliva py-16 text-crema-claro sm:py-24">
    <div class="contenedor grid gap-14 md:grid-cols-2">
      <div>
        <h2 class="text-4xl text-crema-claro sm:text-5xl">Cómo pedir tu vestido con descuento</h2>
        <ol class="mt-8 space-y-5">
          {t.comoPedir.map((paso, i) => (
            <li class="flex gap-4">
              <span class="font-serif text-3xl leading-none italic opacity-80" aria-hidden="true">{i + 1}</span>
              <span>{paso}</span>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="text-4xl text-crema-claro sm:text-5xl">Envíos a toda España</h2>
        <p class="mt-8">{t.envios}</p>
        <WhatsAppButton origen="black-friday-envios" mensaje={bf.mensajeWhatsapp} variante="claro" class="mt-8">
          Reservar mi vestido
        </WhatsAppButton>
      </div>
    </div>
  </section>

  <!-- REGALA CÀROM -->
  <RegalaCarom titulo="Regalo: tarjeta Regala Càrom" headingId="regalo-tarjeta" />
  <div class="contenedor -mt-10 max-w-3xl pb-16 text-center text-cacao-suave sm:-mt-14">
    <p>{t.regalo}</p>
  </div>

  <!-- FAQ -->
  <section class="bg-crema-claro py-16 sm:py-24" aria-labelledby="faq">
    <div class="contenedor max-w-3xl">
      <h2 id="faq" class="text-4xl sm:text-5xl">Preguntas frecuentes del Black Friday</h2>
      <div class="mt-10 divide-y divide-cacao/15 border-y border-cacao/15">
        {faqBlackFriday.map((f, i) => (
          <details class="group py-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-2xl [&::-webkit-details-marker]:hidden">
              <h3 class="text-2xl">{f.pregunta}</h3>
              <span class="text-3xl text-tierra-texto transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-cacao-suave">{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-20 text-center sm:py-28">
    <div class="contenedor max-w-2xl">
      <h2 class="text-4xl sm:text-5xl">¿Ya tienes tu favorito?</h2>
      <p class="mt-5 text-cacao-suave">Las piezas son únicas y vuelan. Escríbenos y te lo reservamos con el {bf.descuento} % de descuento.</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <WhatsAppButton origen="black-friday-final" mensaje={bf.mensajeWhatsapp} />
        <a href={site.instagramMD} target="_blank" rel="noopener" class="btn-secundario" data-umami-event="instagram-dm-click" data-umami-event-origen="black-friday-final">
          <IconInstagram /> MD en Instagram
        </a>
      </div>
      <p class="mt-8 text-sm"><a href="/vestidos" class="underline underline-offset-4 hover:text-tierra-texto">Ver todo el catálogo de vestidos</a></p>
    </div>
  </section>
</BaseLayout>
