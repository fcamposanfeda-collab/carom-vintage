---
import BaseLayout from '../layouts/BaseLayout.astro';
import DressCard from '../components/DressCard.astro';
import Countdown from '../components/Countdown.astro';
import { site, textos } from '../data/site';
import { blackFriday as bf, vestidos, precioFinal } from '../data/blackfriday';

// PROVISIONAL: fotos de la portada y de «Nosotros»
const fotoPortada = '/img/hero-vestido-vintage-invitada-boda.webp';
const fotoPortadaSecundaria = '/img/vestido-vintage-invitada-black-friday.webp';
const fotoNosotros = '/img/quienes-somos-vestidos-vintage-carom.webp';

const base = Astro.site ?? new URL(site.url);
const abs = (ruta: string) => new URL(ruta, base).href;

const disponibilidad = {
  disponible: 'https://schema.org/InStock',
  reservado: 'https://schema.org/LimitedAvailability',
  vendido: 'https://schema.org/SoldOut',
};

const schemaColeccion = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: bf.activo ? `Black Friday ${site.nombre}` : `Colección ${site.nombre}`,
  itemListElement: vestidos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `Vestido ${v.nombre}`,
      description: v.descripcion,
      image: abs(v.imagen),
      size: v.talla,
      brand: { '@type': 'Brand', name: site.nombre },
      offers: {
        '@type': 'Offer',
        price: precioFinal(v.precio).toFixed(2),
        priceCurrency: 'EUR',
        availability: disponibilidad[v.estado],
        itemCondition: 'https://schema.org/UsedCondition',
        ...(bf.activo && { priceValidUntil: bf.fin.slice(0, 10) }),
      },
    },
  })),
};

const desfile = [...textos.desfile, ...textos.desfile];
---
<BaseLayout
  title={bf.activo ? `Black Friday · Vestidos vintage de pieza única | ${site.nombre}` : `Vestidos vintage de pieza única | ${site.nombre}`}
  description={`${textos.portada.texto}${bf.activo ? ` Black Friday: −${bf.descuento} % ${bf.fechasTexto.toLowerCase()}.` : ''}`}
  preloadImage={fotoPortada}
  schemas={[schemaColeccion]}
>
  <!-- PORTADA -->
  <section class="contenedor pt-16 pb-24 sm:pt-24 sm:pb-36">
    <div class="aparece text-center">
      {bf.activo && (
        <p class="etiqueta text-oro-texto">Black Friday · {bf.fechasTexto} · −{bf.descuento} %</p>
      )}
      <h1 class="mt-7 text-[3.2rem] sm:text-7xl lg:text-[6.5rem]">
        {textos.portada.titulo.map((linea, i) => (
          <span class:list={['block', i === 1 && 'italic']}>{linea}</span>
        ))}
      </h1>
    </div>

    <div class="mt-16 grid grid-cols-12 gap-x-4 sm:mt-24 sm:gap-x-8">
      <div class="col-span-5 flex translate-y-12 flex-col justify-end sm:col-span-4 sm:col-start-2 sm:translate-y-28">
        <p class="mb-8 hidden max-w-xs text-tierra sm:block">{textos.portada.texto}</p>
        <img
          src={fotoPortadaSecundaria}
          alt="Vestido vintage largo rojo de la colección CÀROM"
          width="960"
          height="1200"
          decoding="async"
          class="aparece aspect-[3/4] w-full object-cover [animation-delay:300ms]"
        />
      </div>
      <div class="col-span-7 sm:col-span-6">
        <img
          src={fotoPortada}
          alt="Invitada con vestido vintage de tul con flores bordadas"
          width="960"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class="aparece aspect-[4/5] w-full object-cover object-[50%_25%] [animation-delay:150ms]"
        />
      </div>
    </div>
    <p class="mt-10 text-center text-tierra sm:hidden">{textos.portada.texto}</p>

    <p class="mt-24 text-center sm:mt-40">
      <a href="#coleccion" class="enlace">Ver la colección</a>
    </p>
  </section>

  <!-- TEXTO EN MOVIMIENTO -->
  <div class="overflow-hidden bg-oliva py-7 text-crema" aria-hidden="true">
    <div class="desfile flex w-max">
      {desfile.map((frase) => (
        <span class="flex items-center font-serif text-3xl whitespace-nowrap italic sm:text-4xl">
          <span class="px-10">{frase}</span>
          <span class="text-base text-arena not-italic">✦</span>
        </span>
      ))}
    </div>
  </div>

  <!-- COLECCIÓN -->
  <section id="coleccion" class="scroll-mt-8 py-24 sm:py-36" aria-labelledby="titulo-coleccion">
    <div class="contenedor">
      <div class="flex flex-col items-center text-center">
        {bf.activo && <p class="etiqueta text-oro-texto">Black Friday · −{bf.descuento} %</p>}
        <h2 id="titulo-coleccion" class="mt-6 text-6xl sm:text-8xl">{textos.coleccion.titulo}</h2>
        <p class="mt-6 max-w-md font-serif text-2xl italic text-tierra">{textos.coleccion.texto}</p>
        {bf.activo && (
          <div class="mt-14">
            <p class="etiqueta mb-5 text-tierra">Termina en</p>
            <Countdown fin={bf.fin} />
          </div>
        )}
      </div>

      <div class="mt-20 grid gap-x-8 gap-y-20 pb-28 sm:mt-28 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-12">
        {vestidos.map((v, i) => (
          <DressCard
            vestido={v}
            numero={i + 1}
            class:list={[i % 2 === 1 && 'md:max-lg:translate-y-24', i % 3 === 1 && 'lg:translate-y-28']}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- NOSOTROS -->
  <section id="nosotros" class="scroll-mt-8 bg-noche py-24 text-crema sm:py-36" aria-labelledby="titulo-nosotros">
    <div class="contenedor grid items-center gap-14 md:grid-cols-12 md:gap-8">
      <img
        src={fotoNosotros}
        alt="Vestidos vintage colgados en el estudio de CÀROM Studio"
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
        class="aspect-[4/5] w-full object-cover md:col-span-5"
      />
      <div class="md:col-span-6 md:col-start-7">
        <p class="etiqueta text-arena">CÀROM Studio</p>
        <h2 id="titulo-nosotros" class="mt-6 text-6xl sm:text-8xl">{textos.nosotros.titulo}</h2>
        <p class="mt-10 font-serif text-3xl leading-snug text-oro italic sm:text-4xl">{textos.nosotros.entradilla}</p>
        {textos.nosotros.parrafos.map((p) => (
          <p class="mt-6 max-w-lg opacity-85">{p}</p>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
