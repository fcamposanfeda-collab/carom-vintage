---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import DressCard from '../components/DressCard.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BlackFridayBanner from '../components/BlackFridayBanner.astro';
import RegalaCarom from '../components/RegalaCarom.astro';
import InstagramGallery from '../components/InstagramGallery.astro';
import { textos } from '../data/site';
import { vestidos } from '../data/blackfriday';

// PROVISIONAL: ids de los vestidos destacados en el inicio (de 3 a 6)
const idsDestacados = ['triana', 'alhambra', 'donana', 'giralda', 'azahar', 'albaicin'];
const destacados = idsDestacados.map((id) => vestidos.find((v) => v.id === id)).filter((v) => v !== undefined);

const heroImg = '/img/hero-vestido-vintage-invitada-boda.webp';
---
<BaseLayout
  title="Vestidos vintage para bodas e invitadas | CÀROM Studio"
  description="Vestidos vintage para bodas, comuniones, galas e invitadas. Piezas únicas y elegantes con envíos a toda España desde Castilla-La Mancha y Sevilla. Escríbenos por WhatsApp."
  preloadImage={heroImg}
>
  <!-- HERO -->
  <section class="contenedor grid items-center gap-8 pt-5 pb-16 md:grid-cols-[1fr_1.05fr] md:gap-16 md:pt-12 md:pb-24">
    <div class="order-2 md:order-1">
      <p class="eyebrow">Vestidos vintage para eventos</p>
      <h1 class="mt-4 text-[2.6rem] sm:text-6xl lg:text-7xl">{textos.claim}</h1>
      <p class="mt-6 max-w-md text-lg text-cacao-suave">{textos.subclaim}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <WhatsAppButton origen="hero" mensaje="Hola, me gustaría información sobre vuestros vestidos" />
        <a href="/vestidos" class="btn-secundario">Ver vestidos</a>
      </div>
    </div>
    <div class="order-1 md:order-2">
      <img
        src={heroImg}
        alt="Invitada de boda con vestido vintage de tul con flores bordadas"
        width="960"
        height="1200"
        fetchpriority="high"
        decoding="async"
        class="aspect-[5/4] w-full rounded-sm object-cover object-[50%_25%] md:aspect-[4/5]"
      />
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section class="bg-crema-claro py-20 sm:py-28" aria-labelledby="quienes-somos">
    <div class="contenedor grid items-center gap-12 md:grid-cols-[0.8fr_1fr] md:gap-20">
      <img
        src="/img/quienes-somos-vestidos-vintage-carom.webp"
        alt="Vestidos vintage colgados en el estudio de CÀROM Studio"
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
        class="aspect-[4/5] w-full max-w-sm rounded-sm object-cover"
      />
      <div>
        <p class="eyebrow">CÀROM Studio</p>
        <h2 id="quienes-somos" class="mt-3 text-4xl sm:text-5xl">{textos.quienesSomos.titulo}</h2>
        <p class="mt-6 max-w-lg font-serif text-2xl leading-snug text-cacao sm:text-[1.7rem]">
          {textos.quienesSomos.texto}
        </p>
        <p class="mt-5 text-sm text-cacao-suave">{textos.modalidad}</p>
      </div>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="py-20 sm:py-28" aria-labelledby="destacados">
    <div class="contenedor">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">Recién llegados</p>
          <h2 id="destacados" class="mt-3 text-4xl sm:text-5xl">Vestidos destacados</h2>
        </div>
        <a href="/vestidos" class="text-sm tracking-wide underline underline-offset-4 hover:text-tierra-texto">Ver todos los vestidos</a>
      </div>
      <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {destacados.map((v) => <DressCard vestido={v} origen="inicio-destacados" />)}
      </div>
    </div>
  </section>

  <HowItWorks />

  <BlackFridayBanner />

  <RegalaCarom />

  <InstagramGallery />
</BaseLayout>
