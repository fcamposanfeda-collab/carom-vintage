---
import BaseLayout from '../layouts/BaseLayout.astro';
import DressCard from '../components/DressCard.astro';
import Countdown from '../components/Countdown.astro';
import { site, textos, faq, contactoLink } from '../data/site';
import { blackFriday as bf, vestidos, precioFinal, imagenPrincipal, rutaVestido } from '../data/blackfriday';

// PROVISIONAL: fotos de portada, invitadas y nosotros
const fotoPortada = '/img/fondo-portada-black-friday.webp';
const fotoInvitadas = '/img/hero-vestido-vintage-invitada-boda.webp';
const fotoNosotros = '/img/quienes-somos-vestidos-vintage-carom.webp';

const base = Astro.site ?? new URL(site.url);
const abs = (ruta: string) => new URL(ruta, base).href;
const disponibles = vestidos.filter((v) => v.estado === 'disponible').length;

const disponibilidad = {
  disponible: 'https://schema.org/InStock',
  reservado: 'https://schema.org/LimitedAvailability',
  vendido: 'https://schema.org/SoldOut',
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const schemaColeccion = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: bf.activo ? `Black Friday ${site.nombre}` : `Colección ${site.nombre}`,
  itemListElement: vestidos.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: v.nombre,
      description: v.descripcion || `${v.nombre}: pieza vintage única.`,
      url: abs(rutaVestido(v.id)),
      ...(imagenPrincipal(v) && { image: abs(imagenPrincipal(v)) }),
      ...(v.talla && { size: v.talla }),
      brand: { '@type': 'Brand', name: site.nombre },
      ...(v.precio !== null && {
        offers: {
          '@type': 'Offer',
          price: precioFinal(v.precio).toFixed(2),
          priceCurrency: 'EUR',
          availability: disponibilidad[v.estado],
          itemCondition: 'https://schema.org/UsedCondition',
          ...(bf.activo && { priceValidUntil: bf.fin.slice(0, 10) }),
        },
      }),
    },
  })),
};
---
<BaseLayout
  title={bf.activo ? `Black Friday · Vestidos vintage de pieza única | ${site.nombre}` : `Vestidos vintage de pieza única | ${site.nombre}`}
  description={`${textos.portada.claim} ${textos.portada.texto} Acceso privado ${bf.fechasTexto.toLowerCase()}.`}
  preloadImage={fotoPortada}
  schemas={[schemaColeccion, schemaFaq]}
>
  <!-- HERO -->
  <section class="relative min-h-[min(860px,92vh)]" aria-label="Black Friday">
    <img
      src={fotoPortada}
      alt=""
      width="1600"
      height="2000"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[50%_40%]"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-tinta/50" aria-hidden="true"></div>
    <div class="contenedor relative flex min-h-[min(860px,92vh)] flex-col justify-end gap-7 pt-28 pb-12 sm:gap-8 sm:pb-20">
      <h1 class="reveal font-serif text-[clamp(5rem,13vw,12.25rem)] leading-[0.86] font-light tracking-[-0.02em] italic">
        Black<br />Friday
      </h1>
      <div class="reveal flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-lg">
          <p class="etiqueta text-pergamino">{textos.portada.etiqueta}</p>
          <p class="mt-4 font-serif text-[1.45rem] leading-snug sm:text-[1.75rem]">{textos.portada.claim}</p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-pergamino sm:text-base">{textos.portada.texto}</p>
        </div>
        <a href="#coleccion" class="btn-linea w-full sm:w-auto">Descubrir la selección</a>
      </div>
    </div>
  </section>

  {bf.activo && <Countdown inicio={bf.inicio} fin={bf.fin} />}

  <!-- MANIFIESTO -->
  <section class="bg-crema text-noche">
    <div class="contenedor grid items-end gap-10 py-20 sm:gap-16 sm:py-28 md:grid-cols-2">
      <h2 class="reveal text-[clamp(2.75rem,6vw,5.25rem)] leading-none">
        {textos.manifiesto.titulo[0]}
        <br />
        <span class="italic">{textos.manifiesto.titulo[1]}</span>
      </h2>
      <div class="reveal flex flex-col gap-5 text-[1.05rem] leading-relaxed text-tierra">
        <p>{textos.manifiesto.texto}</p>
        <p class="etiqueta text-oliva">{textos.manifiesto.etiqueta}</p>
      </div>
    </div>
  </section>

  <!-- COLECCIÓN -->
  <section id="coleccion" class="scroll-mt-8 bg-crema pb-20 text-noche sm:pb-28" aria-labelledby="titulo-coleccion">
    <div class="contenedor">
      <div class="mb-10 flex flex-wrap items-baseline justify-between gap-4 border-t border-arena pt-7">
        <h2 id="titulo-coleccion" class="text-4xl font-normal">{textos.coleccion.titulo}</h2>
        <a href={contactoLink()} target="_blank" rel="noopener" class="etiqueta text-tierra transition-colors hover:text-oliva" data-umami-event="instagram-md-click" data-umami-event-origen="coleccion-cabecera">
          {disponibles} {disponibles === 1 ? 'pieza disponible' : 'piezas disponibles'}
        </a>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-4">
        {vestidos.map((v, i) => <DressCard vestido={v} prioridad={i < 4} />)}
      </div>
    </div>
  </section>

  <!-- INVITADAS -->
  <section id="invitadas" class="scroll-mt-8 flex flex-wrap bg-noche">
    <div class="flex flex-[1_1_480px] flex-col justify-center gap-7 px-6 py-20 sm:px-16 sm:py-28">
      <p class="reveal etiqueta text-arena">{textos.invitadas.eyebrow}</p>
      <h2 class="reveal text-[clamp(2.5rem,5vw,4.25rem)] leading-[1.05]">
        {textos.invitadas.titulo[0]}
        <br />
        <span class="italic">{textos.invitadas.titulo[1]}</span>
      </h2>
      <p class="reveal max-w-md text-[1.05rem] leading-relaxed text-pergamino">{textos.invitadas.texto}</p>
      <a href="#coleccion" class="reveal btn-claro self-start">Ver la selección</a>
    </div>
    <div class="relative min-h-[420px] flex-[1_1_480px] sm:min-h-[640px]">
      <img
        src={fotoInvitadas}
        alt="Invitada con vestido vintage a la luz cálida"
        width="1200"
        height="1500"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[70%_80%]"
      />
    </div>
  </section>

  <!-- NOSOTROS -->
  <section id="nosotros" class="scroll-mt-8 border-t border-crema/15 py-20 sm:py-28" aria-labelledby="titulo-nosotros">
    <div class="contenedor grid items-center gap-12 md:grid-cols-12 md:gap-8">
      <img
        src={fotoNosotros}
        alt="Vestidos vintage colgados en el estudio de CÀROM Studio"
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
        class="reveal aspect-[4/5] w-full object-cover md:col-span-5"
      />
      <div class="md:col-span-6 md:col-start-7">
        <p class="reveal etiqueta text-arena">CÀROM Studio</p>
        <h2 id="titulo-nosotros" class="reveal mt-6 text-6xl sm:text-7xl">{textos.nosotros.titulo}</h2>
        <p class="reveal mt-8 font-serif text-3xl leading-snug text-arena italic sm:text-4xl">{textos.nosotros.entradilla}</p>
        {textos.nosotros.parrafos.map((p) => (
          <p class="reveal mt-6 max-w-lg text-pergamino">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-8 border-t border-crema/15 bg-crema py-20 text-noche sm:py-28" aria-labelledby="titulo-faq">
    <div class="contenedor max-w-3xl">
      <p class="reveal etiqueta text-oliva">Preguntas frecuentes</p>
      <h2 id="titulo-faq" class="reveal mt-5 text-5xl sm:text-6xl">FAQ</h2>
      <div class="mt-12 divide-y divide-noche/15 border-y border-noche/15">
        {faq.map((f, i) => (
          <details class="reveal group py-6" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-2xl [&::-webkit-details-marker]:hidden">
              <h3 class="text-2xl font-light">{f.pregunta}</h3>
              <span class="text-3xl text-oliva transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 text-tierra">{f.respuesta}</p>
          </details>
        ))}
      </div>
      <p class="reveal mt-10 text-center">
        <a href={contactoLink()} target="_blank" rel="noopener" class="etiqueta text-oliva transition-colors hover:text-noche" data-umami-event="instagram-md-click" data-umami-event-origen="faq">
          ¿Otra duda? Escríbenos por Instagram
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
