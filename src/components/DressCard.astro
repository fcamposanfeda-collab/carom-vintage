---
import { whatsappLink, mensajeVestido } from '../data/site';
import { blackFriday, precioFinal, formatoPrecio, type Vestido } from '../data/blackfriday';

interface Props {
  vestido: Vestido;
  numero: number;
  class?: string;
}
const { vestido: v, numero, class: className = '' } = Astro.props;
const disponible = v.estado === 'disponible';
const rebajado = blackFriday.activo && disponible;
const estadoTexto = { disponible: '', reservado: 'Reservado', vendido: 'Ha encontrado dueña' }[v.estado];
---
<article class:list={['group', className]}>
  <div class="relative overflow-hidden bg-lino">
    <img
      src={v.imagen}
      alt={v.alt}
      width="800"
      height="1067"
      loading={numero <= 2 ? 'eager' : 'lazy'}
      decoding="async"
      class:list={[
        'aspect-[3/4] w-full object-cover transition duration-[1.6s] ease-out group-hover:scale-[1.04]',
        !disponible && 'opacity-45 grayscale',
      ]}
    />
    {!disponible && (
      <p class="etiqueta absolute bottom-6 left-1/2 -translate-x-1/2 bg-marfil/90 px-5 py-2 whitespace-nowrap text-tinta">{estadoTexto}</p>
    )}
  </div>

  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <p class="etiqueta text-tinta-suave">Nº {String(numero).padStart(2, '0')}</p>
      <h3 class="mt-2 text-[2.1rem] sm:text-[2.4rem]">{v.nombre}</h3>
      <p class="mt-1 text-sm text-tinta-suave">{v.descripcion}</p>
    </div>
    <p class="shrink-0 pt-1 text-right font-serif text-xl leading-tight">
      {rebajado ? (
        <>
          <span class="sr-only">Antes</span>
          <s class="block text-base text-tinta-suave">{formatoPrecio(v.precio)}</s>
          <span class="sr-only">ahora</span>
          <span class="text-vino">{formatoPrecio(precioFinal(v.precio))}</span>
        </>
      ) : (
        <span class:list={[!disponible && 'text-tinta-suave line-through']}>{formatoPrecio(v.precio)}</span>
      )}
    </p>
  </div>

  <div class="mt-5 flex items-center justify-between border-t border-tinta/15 pt-4">
    <p class="etiqueta">Talla {v.talla} · Pieza única</p>
    {disponible && (
      <a
        href={whatsappLink(mensajeVestido(v.nombre, v.talla))}
        target="_blank"
        rel="noopener"
        class="enlace"
        data-umami-event="whatsapp-click"
        data-umami-event-origen="coleccion"
        data-umami-event-vestido={v.nombre}
        aria-label={`Reservar el vestido ${v.nombre}, talla ${v.talla}, por WhatsApp`}
      >
        Reservar
      </a>
    )}
  </div>
</article>
