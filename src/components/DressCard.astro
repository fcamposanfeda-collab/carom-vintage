---
import { contactoLink } from '../data/site';
import { blackFriday, precioFinal, formatoPrecio, type Vestido } from '../data/blackfriday';

interface Props {
  vestido: Vestido;
  prioridad?: boolean;
}
const { vestido: v, prioridad = false } = Astro.props;
const disponible = v.estado === 'disponible';
const rebajado = blackFriday.activo && disponible;
const estadoTexto = { disponible: '', reservado: 'Reservado', vendido: 'Vendido' }[v.estado];
---
<article class="reveal flex flex-col gap-3.5 text-noche">
  <div class="relative aspect-[3/4] overflow-hidden bg-lino">
    <img
      src={v.imagen}
      alt={v.alt}
      width="800"
      height="1067"
      loading={prioridad ? 'eager' : 'lazy'}
      decoding="async"
      class:list={[
        'h-full w-full object-cover transition duration-[1.2s] ease-out hover:scale-[1.04]',
        !disponible && 'opacity-50 grayscale',
      ]}
    />
    {rebajado ? (
      <p class="absolute top-3.5 left-3.5 bg-tinta px-2.5 py-1.5 text-[0.68rem] tracking-[0.2em] text-crema uppercase">
        −{blackFriday.descuento} %
      </p>
    ) : (
      <p class="absolute top-3.5 left-3.5 bg-tinta px-2.5 py-1.5 text-[0.68rem] tracking-[0.2em] text-crema uppercase">
        Pieza única
      </p>
    )}
  </div>

  <div class="flex flex-col gap-1">
    <p class="text-[0.68rem] tracking-[0.24em] text-tierra uppercase">Pieza única · {v.decada}</p>
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-[1.35rem] text-noche sm:text-[1.4rem]">{v.nombre}</h3>
      <p class="shrink-0 text-sm">
        {rebajado ? (
          <>
            <s class="text-tierra">{formatoPrecio(v.precio)}</s>
            <span class="text-tierra"> · </span>
            <strong class="font-medium text-oliva">{formatoPrecio(precioFinal(v.precio))}</strong>
          </>
        ) : (
          <span class:list={[!disponible && 'text-tierra line-through']}>{formatoPrecio(v.precio)}</span>
        )}
      </p>
    </div>
    <p class="text-sm text-tierra">Talla {v.talla}</p>
  </div>

  {disponible ? (
    <a
      href={contactoLink()}
      target="_blank"
      rel="noopener"
      class="etiqueta mt-1 block bg-tinta py-3.5 text-center text-crema transition-colors duration-300 hover:bg-oliva"
      data-umami-event="instagram-md-click"
      data-umami-event-origen="coleccion"
      data-umami-event-vestido={v.nombre}
      aria-label={`Lo quiero: vestido ${v.nombre}, talla ${v.talla}, escribir por Instagram`}
    >
      Lo quiero
    </a>
  ) : (
    <p class="etiqueta mt-1 border border-noche/20 py-3.5 text-center text-tierra">{estadoTexto}</p>
  )}
</article>
