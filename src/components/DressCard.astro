---
import { whatsappLink, mensajeVestido } from '../data/site';
import { blackFriday, precioFinal, formatoPrecio, type Vestido } from '../data/blackfriday';

interface Props {
  vestido: Vestido;
  prioridad?: boolean;
}
const { vestido: v, prioridad = false } = Astro.props;
const disponible = v.estado === 'disponible';
const rebajado = blackFriday.activo && disponible;
const estadoTexto = { disponible: '', reservado: 'Reservado', vendido: 'Vendido' }[v.estado];
---
<article class="flex flex-col">
  <div class="relative overflow-hidden bg-lino">
    <img
      src={v.imagen}
      alt={v.alt}
      width="800"
      height="1067"
      loading={prioridad ? 'eager' : 'lazy'}
      decoding="async"
      class:list={[
        'aspect-[3/4] w-full object-cover transition duration-[1.6s] ease-out hover:scale-[1.03]',
        !disponible && 'opacity-50 grayscale',
      ]}
    />
    {rebajado && (
      <p class="absolute top-3 left-3 bg-noche px-2 py-1 text-[0.65rem] font-normal tracking-wider text-crema sm:top-4 sm:left-4">
        −{blackFriday.descuento} %
      </p>
    )}
  </div>

  <div class="mt-4 flex flex-1 flex-col justify-between gap-2 sm:flex-row sm:items-end sm:gap-3">
    <div class="min-w-0">
      <p class="text-[0.55rem] tracking-[0.2em] text-tierra uppercase sm:text-[0.65rem] sm:tracking-[0.25em]">
        Pieza única · {v.decada}
      </p>
      <h3 class="mt-1.5 text-[1.4rem] sm:text-3xl">{v.nombre}</h3>
      <p class="mt-0.5 text-xs text-tierra sm:text-sm">Talla {v.talla}</p>
    </div>
    <p class="flex shrink-0 items-baseline gap-2 font-serif leading-tight sm:block sm:text-right">
      {rebajado ? (
        <>
          <span class="sr-only">Antes</span>
          <s class="block text-sm text-tierra">{formatoPrecio(v.precio)}</s>
          <span class="sr-only">ahora</span>
          <span class="text-xl sm:text-2xl">{formatoPrecio(precioFinal(v.precio))}</span>
        </>
      ) : (
        <span class:list={['text-xl sm:text-2xl', !disponible && 'text-tierra line-through']}>{formatoPrecio(v.precio)}</span>
      )}
    </p>
  </div>

  {disponible ? (
    <a
      href={whatsappLink(mensajeVestido(v.nombre, v.talla))}
      target="_blank"
      rel="noopener"
      class="etiqueta mt-4 block bg-tinta py-3.5 text-center text-crema max-sm:tracking-[0.2em] transition-colors duration-300 hover:bg-oliva"
      data-umami-event="whatsapp-click"
      data-umami-event-origen="coleccion"
      data-umami-event-vestido={v.nombre}
      aria-label={`Lo quiero: vestido ${v.nombre}, talla ${v.talla}, escribir por WhatsApp`}
    >
      Lo quiero
    </a>
  ) : (
    <p class="etiqueta mt-4 border border-tinta/20 py-3.5 text-center text-tierra max-sm:tracking-[0.2em]">{estadoTexto}</p>
  )}
</article>
