---
import { blackFriday, hayDescuento, precioFinal, formatoPrecio, rutaVestido, imagenPrincipal, type Vestido } from '../data/blackfriday';

interface Props {
  vestido: Vestido;
  prioridad?: boolean;
}
const { vestido: v, prioridad = false } = Astro.props;
const disponible = v.estado === 'disponible';
const rebajado = hayDescuento() && disponible && v.precio !== null;
const foto = imagenPrincipal(v);
const ruta = rutaVestido(v.id);
const estadoTexto = { disponible: '', reservado: 'Reservado', vendido: 'Vendido' }[v.estado];
---
<article class="reveal flex flex-col gap-3.5 text-noche">
  <a href={ruta} class="group relative block aspect-[3/4] overflow-hidden bg-lino" aria-label={`Ver ${v.nombre}`}>
    {foto ? (
      <img
        src={foto}
        alt={v.alt}
        width="800"
        height="1067"
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'h-full w-full object-cover transition duration-[1.2s] ease-out group-hover:scale-[1.04]',
          !disponible && 'opacity-50 grayscale',
        ]}
      />
    ) : (
      <span class="etiqueta absolute inset-0 flex items-center justify-center px-4 text-center text-tierra">
        Foto pendiente
      </span>
    )}
    {rebajado ? (
      <p class="absolute top-3.5 left-3.5 bg-tinta px-2.5 py-1.5 text-[0.68rem] tracking-[0.2em] text-crema uppercase">
        −{blackFriday.descuento} %
      </p>
    ) : (
      <p class="absolute top-3.5 left-3.5 bg-tinta px-2.5 py-1.5 text-[0.68rem] tracking-[0.2em] text-crema uppercase">
        Pieza única
      </p>
    )}
    {!disponible && (
      <p class="etiqueta absolute inset-x-0 bottom-6 text-center text-tinta">{estadoTexto}</p>
    )}
  </a>

  <div class="flex flex-col gap-1">
    <p class="text-[0.68rem] tracking-[0.24em] text-tierra uppercase">Pieza única</p>
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-[1.35rem] text-noche sm:text-[1.4rem]">
        <a href={ruta} class="transition-opacity hover:opacity-70">{v.nombre}</a>
      </h3>
      {v.precio !== null && (
        <p class="shrink-0 text-sm">
          {rebajado ? (
            <>
              <s class="text-tierra">{formatoPrecio(v.precio)}</s>
              <span class="text-tierra"> · </span>
              <strong class="font-medium text-oliva">{formatoPrecio(precioFinal(v.precio))}</strong>
            </>
          ) : (
            <span class:list={[!disponible && 'text-tierra line-through']}>{formatoPrecio(v.precio)}</span>
          )}
        </p>
      )}
    </div>
    {v.talla ? (
      <p class="text-sm text-tierra">Talla {v.talla}</p>
    ) : (
      <p class="text-sm text-tierra">Talla pendiente</p>
    )}
  </div>

  <a
    href={ruta}
    class="etiqueta mt-1 block border border-noche/25 py-3.5 text-center text-noche transition-colors duration-300 hover:bg-noche hover:text-crema"
  >
    Ver pieza
  </a>
</article>
