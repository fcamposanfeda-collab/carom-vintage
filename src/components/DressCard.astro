---
import { formatoPrecio, rutaVestido, imagenPrincipal, type Vestido } from '../data/blackfriday';

interface Props {
  vestido: Vestido;
  prioridad?: boolean;
  /** claro = fondo blanco; oscuro = fondo oliva */
  tono?: 'claro' | 'oscuro';
}
const { vestido: v, prioridad = false, tono = 'claro' } = Astro.props;
const disponible = v.estado === 'disponible';
const foto = imagenPrincipal(v);
const ruta = rutaVestido(v.id);
const estadoTexto = { disponible: '', reservado: 'Reservado', vendido: 'Vendido' }[v.estado];
const oscuro = tono === 'oscuro';
---
<article class:list={['reveal flex flex-col gap-3.5', oscuro ? 'text-crema' : 'text-oliva']}>
  <a href={ruta} class="group relative block aspect-[3/4] overflow-hidden bg-lino" aria-label={`Ver ${v.nombre}`}>
    {foto ? (
      <img
        src={foto}
        alt={v.alt}
        width="800"
        height="1067"
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'h-full w-full object-cover transition duration-[1.2s] ease-out group-hover:scale-[1.04]',
          !disponible && 'opacity-50 grayscale',
        ]}
      />
    ) : (
      <span
        class:list={[
          'etiqueta absolute inset-0 flex items-center justify-center px-4 text-center',
          oscuro ? 'text-oliva' : 'text-oliva',
        ]}
      >
        Foto pendiente
      </span>
    )}
    <p
      class:list={[
        'absolute top-3.5 left-3.5 px-2.5 py-1.5 text-[0.68rem] tracking-[0.2em] uppercase',
        oscuro ? 'bg-crema text-oliva' : 'bg-oliva text-crema',
      ]}
    >
      Pieza única
    </p>
    {!disponible && (
      <p class:list={['etiqueta absolute inset-x-0 bottom-6 text-center', oscuro ? 'text-crema' : 'text-oliva']}>
        {estadoTexto}
      </p>
    )}
  </a>

  <div class="flex flex-col gap-1">
    <p class:list={['text-[0.68rem] tracking-[0.24em] uppercase', oscuro ? 'text-crema/70' : 'text-oliva/70']}>
      Pieza única
    </p>
    <div class="flex items-baseline justify-between gap-3">
      <h3 class:list={['text-[1.35rem] sm:text-[1.4rem]', oscuro ? 'text-crema' : 'text-oliva']}>
        <a href={ruta} class="transition-opacity hover:opacity-70">{v.nombre}</a>
      </h3>
      {v.precio !== null && (
        <p
          class:list={[
            'shrink-0 text-sm',
            !disponible && (oscuro ? 'text-crema/60 line-through' : 'text-oliva/60 line-through'),
          ]}
        >
          {formatoPrecio(v.precio)}
        </p>
      )}
    </div>
    {v.talla ? (
      <p class:list={['text-sm', oscuro ? 'text-crema/80' : 'text-oliva/80']}>Talla {v.talla}</p>
    ) : (
      <p class:list={['text-sm', oscuro ? 'text-crema/80' : 'text-oliva/80']}>Talla pendiente</p>
    )}
  </div>

  <a
    href={ruta}
    class:list={[
      'etiqueta mt-1 block border py-3.5 text-center transition-colors duration-300',
      oscuro
        ? 'border-crema/35 text-crema hover:bg-crema hover:text-oliva'
        : 'border-oliva/30 text-oliva hover:bg-oliva hover:text-crema',
    ]}
  >
    Ver pieza
  </a>
</article>
