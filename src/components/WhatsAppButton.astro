---
import IconWhatsApp from './IconWhatsApp.astro';
import { whatsappLink } from '../data/site';

interface Props {
  mensaje?: string;
  origen: string;
  variante?: 'primario' | 'secundario' | 'claro' | 'linea-clara';
  class?: string;
  ariaLabel?: string;
}
const { mensaje, origen, variante = 'primario', class: className = '', ariaLabel } = Astro.props;
---
<a
  href={whatsappLink(mensaje)}
  target="_blank"
  rel="noopener"
  class:list={[`btn-${variante}`, className]}
  data-umami-event="whatsapp-click"
  data-umami-event-origen={origen}
  aria-label={ariaLabel}
>
  <IconWhatsApp class="h-5 w-5 shrink-0" />
  <slot>Escríbenos por WhatsApp</slot>
</a>
