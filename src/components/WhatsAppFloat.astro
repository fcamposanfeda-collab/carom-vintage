---
import IconWhatsApp from './IconWhatsApp.astro';
import { whatsappLink } from '../data/site';
---
<a
  href={whatsappLink('Hola, tengo una duda sobre un vestido')}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-oliva text-crema-claro shadow-lg shadow-cacao/25 transition-transform duration-200 hover:scale-105 hover:bg-oliva-oscuro sm:right-6 sm:bottom-6"
  aria-label="Escríbenos por WhatsApp"
  data-umami-event="whatsapp-click"
  data-umami-event-origen="boton-flotante"
>
  <IconWhatsApp class="h-7 w-7" />
</a>
