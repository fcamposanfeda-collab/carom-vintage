---
---
<div
  class="puerta"
  id="puerta"
  role="dialog"
  aria-modal="true"
  aria-labelledby="titulo-puerta"
>
  <div class="puerta__rendija" aria-hidden="true"></div>

  <div class="puerta__hoja puerta__hoja--izq" aria-hidden="true">
    <span class="puerta__moldura"></span>
    <span class="puerta__moldura puerta__moldura--baja"></span>
    <span class="puerta__tirador"></span>
  </div>
  <div class="puerta__hoja puerta__hoja--der" aria-hidden="true">
    <span class="puerta__moldura"></span>
    <span class="puerta__moldura puerta__moldura--baja"></span>
    <span class="puerta__tirador"></span>
  </div>

  <div class="puerta__contenido">
    <div class="puerta__placa">
      <p class="etiqueta">Black Friday · CÀROM Studio</p>
      <h2 id="titulo-puerta" class="font-serif text-[clamp(3rem,7vw,5.5rem)] leading-[0.95] font-light italic">Acceso privado</h2>
      <button type="button" class="btn-linea" id="boton-puerta">Accede aquí</button>
    </div>
  </div>
</div>

<script>
  const CLAVE = 'carom-puerta-abierta';
  const puerta = document.getElementById('puerta')!;
  const boton = document.getElementById('boton-puerta')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function iniciarReveal() {
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }

  function abrir() {
    puerta.classList.add('is-abierta');
    document.body.classList.remove('is-bloqueado');
    try {
      sessionStorage.setItem(CLAVE, '1');
    } catch {}
    setTimeout(() => puerta.classList.add('is-fuera'), reduce ? 300 : 2400);
    setTimeout(iniciarReveal, reduce ? 0 : 1400);
  }

  let yaAbierta = false;
  try {
    yaAbierta = sessionStorage.getItem(CLAVE) === '1';
  } catch {}

  if (yaAbierta) {
    puerta.classList.add('is-fuera');
    document.documentElement.classList.add('puerta-ya-abierta');
    document.body.classList.remove('is-bloqueado');
    iniciarReveal();
  } else {
    document.body.classList.add('is-bloqueado');
    boton.focus({ preventScroll: true });
    boton.addEventListener('click', abrir);
  }
</script>

<style is:global>
  body.is-bloqueado {
    overflow: hidden;
  }

  .puerta {
    position: fixed;
    inset: 0;
    z-index: 100;
    perspective: 2400px;
    background: transparent;
  }
  .puerta.is-fuera,
  .puerta-ya-abierta .puerta {
    display: none;
  }

  .puerta__rendija {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 1;
    width: 2px;
    transform: translateX(-50%);
    background: #f6d9a8;
    box-shadow:
      0 0 24px 6px rgba(246, 217, 168, 0.35),
      0 0 120px 30px rgba(246, 217, 168, 0.12);
    opacity: 0.55;
    animation: parpadeo 3.2s ease-in-out infinite;
  }
  @keyframes parpadeo {
    0%,
    100% {
      opacity: 0.45;
    }
    40% {
      opacity: 0.7;
    }
    60% {
      opacity: 0.5;
    }
    80% {
      opacity: 0.65;
    }
  }

  .puerta__hoja {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    width: 50%;
    flex-direction: column;
    gap: 4vh;
    padding: 7vh 5vw;
    background: var(--color-oliva);
    backface-visibility: hidden;
    transition: transform 2.2s cubic-bezier(0.65, 0, 0.25, 1);
  }
  .puerta__hoja--izq {
    left: 0;
    transform-origin: left center;
    border-right: 1px solid rgba(0, 0, 0, 0.5);
  }
  .puerta__hoja--der {
    right: 0;
    transform-origin: right center;
    border-left: 1px solid rgba(0, 0, 0, 0.5);
  }

  .puerta__moldura {
    flex: 1 1 auto;
    border: 1px solid rgba(243, 234, 220, 0.22);
    outline: 1px solid rgba(243, 234, 220, 0.08);
    outline-offset: 10px;
  }
  .puerta__moldura--baja {
    flex: 0 0 26vh;
  }

  .puerta__tirador {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 120px;
    transform: translateY(-50%);
    border-radius: 2px;
    background: linear-gradient(var(--color-arena), #8f7a5e);
  }
  .puerta__hoja--izq .puerta__tirador {
    right: 28px;
  }
  .puerta__hoja--der .puerta__tirador {
    left: 28px;
  }

  .puerta__contenido {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 24px;
    text-align: center;
    transition: opacity 0.8s ease;
  }
  .puerta__placa {
    display: flex;
    max-width: 520px;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    border: 1px solid var(--color-oliva);
    background: #f3eadc;
    color: var(--color-oliva);
    padding: 48px 56px;
  }
  .puerta__placa .btn-linea {
    border-color: var(--color-oliva);
    color: var(--color-oliva);
  }
  .puerta__placa .btn-linea:hover {
    background: var(--color-oliva);
    color: #f3eadc;
  }

  .puerta.is-abierta .puerta__contenido {
    pointer-events: none;
    opacity: 0;
  }
  .puerta.is-abierta .puerta__rendija {
    animation: none;
    opacity: 0;
    transition: opacity 0.6s ease 0.2s;
  }
  .puerta.is-abierta .puerta__hoja--izq {
    transform: rotateY(-105deg);
    transition-delay: 0.35s;
  }
  .puerta.is-abierta .puerta__hoja--der {
    transform: rotateY(105deg);
    transition-delay: 0.35s;
  }

  @media (max-width: 820px) {
    .puerta__hoja {
      padding: 5vh 6vw;
    }
    .puerta__placa {
      padding: 36px 28px;
    }
    .puerta__tirador {
      height: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .puerta__rendija {
      animation: none;
    }
    .puerta__hoja {
      transition: none;
    }
    .puerta.is-abierta .puerta__hoja--izq,
    .puerta.is-abierta .puerta__hoja--der {
      transform: none;
      opacity: 0;
    }
  }
</style>
