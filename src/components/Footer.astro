---
import Logo from './Logo.astro';
import { site, whatsappLink } from '../data/site';

const anio = new Date().getFullYear();
---
<footer class="bg-lino text-tinta">
  <div class="contenedor flex flex-col items-center py-20 text-center sm:py-24">
    <p class="etiqueta text-oro-texto">¿Te has enamorado de una pieza?</p>
    <h2 class="mt-6 text-5xl sm:text-7xl">Escríbenos</h2>
    <ul class="etiqueta mt-12 flex flex-col items-center gap-5 sm:flex-row sm:gap-12">
      <li>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="enlace" data-umami-event="whatsapp-click" data-umami-event-origen="pie">WhatsApp</a>
      </li>
      <li>
        <a href={site.instagram} target="_blank" rel="noopener" class="enlace" data-umami-event="instagram-click" data-umami-event-origen="pie">Instagram</a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} class="enlace" data-umami-event="email-click">{site.email}</a>
      </li>
    </ul>
    <Logo class="mt-20 text-oliva" />
    <p class="mt-8 text-xs text-tierra">© {anio} {site.nombre}. Envíos a toda España.</p>
  </div>
</footer>
