---
import { blackFriday } from '../data/blackfriday';
---
{blackFriday.activo && (
  <section class="bg-cacao text-crema" aria-labelledby="banner-black-friday">
    <div class="contenedor grid items-center gap-10 py-16 md:grid-cols-[1fr_1.1fr] md:py-0">
      <div class="md:py-20">
        <p class="text-xs font-medium tracking-[0.3em] text-crema/80 uppercase">Solo {blackFriday.fechasTexto}</p>
        <h2 id="banner-black-friday" class="mt-4 text-5xl text-crema sm:text-6xl">
          <span class="whitespace-nowrap">Black Friday</span>
          <span class="block text-tierra-claro italic">−{blackFriday.descuento} %</span>
        </h2>
        <p class="mt-5 max-w-md text-crema/85">
          Vestidos vintage para bodas e invitadas con un {blackFriday.descuento} % de descuento. Piezas únicas: cuando se van, no vuelven.
        </p>
        <a href="/black-friday" class="btn-claro mt-8">Ver vestidos en oferta</a>
      </div>
      <a href="/black-friday" class="block md:h-full" tabindex="-1" aria-hidden="true">
        <img
          src={blackFriday.imagen}
          alt=""
          width="960"
          height="1200"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-full md:max-h-[560px] md:rounded-none"
        />
      </a>
    </div>
  </section>
)}
