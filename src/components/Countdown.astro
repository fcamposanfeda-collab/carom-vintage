---
interface Props {
  fin: string;
  class?: string;
}
const { fin, class: className = '' } = Astro.props;
const unidades = [
  ['dias', 'días'],
  ['horas', 'horas'],
  ['min', 'min'],
  ['seg', 'seg'],
];
---
<div class:list={['cuenta-atras', className]} data-fin={fin} role="timer" aria-label="Tiempo restante del Black Friday">
  <ul class="flex gap-6 sm:gap-9">
    {unidades.map(([clave, texto]) => (
      <li class="flex flex-col items-center">
        <span class="font-serif text-4xl leading-none tabular-nums sm:text-5xl" data-unidad={clave}>--</span>
        <span class="etiqueta mt-2 opacity-70">{texto}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.cuenta-atras').forEach((el) => {
    const fin = new Date(el.dataset.fin!).getTime();
    const celdas = Object.fromEntries(
      [...el.querySelectorAll<HTMLElement>('[data-unidad]')].map((c) => [c.dataset.unidad, c]),
    );
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const resto = Math.max(0, fin - Date.now());
      const s = Math.floor(resto / 1000);
      celdas.dias.textContent = pad(Math.floor(s / 86400));
      celdas.horas.textContent = pad(Math.floor((s % 86400) / 3600));
      celdas.min.textContent = pad(Math.floor((s % 3600) / 60));
      celdas.seg.textContent = pad(s % 60);
      if (resto === 0) clearInterval(timer);
    };
    const timer = setInterval(tick, 1000);
    tick();
  });
</script>
