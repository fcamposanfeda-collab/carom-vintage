---
interface Props {
  fin: string;
  inicio?: string;
}
const { fin } = Astro.props;
const unidades = [
  ['dias', 'Días'],
  ['horas', 'Horas'],
  ['min', 'Min'],
  ['seg', 'Seg'],
];
const textos = {
  durante: 'El Black Friday termina en',
  despues: 'El Black Friday ha terminado. Hasta el año que viene.',
};
---
<section class="cuenta-atras border-b border-noche/10 bg-white text-noche" data-fin={fin} data-textos={JSON.stringify(textos)}>
  <div class="contenedor flex flex-wrap items-center justify-between gap-6 py-9">
    <p class="cuenta-atras-texto font-serif text-[1.75rem] italic">{textos.durante}</p>
    <ul class="flex gap-6 sm:gap-10" role="timer" aria-label="Tiempo restante del Black Friday">
      {unidades.map(([clave, texto]) => (
        <li class="flex flex-col items-center gap-1">
          <span class="font-serif text-4xl leading-none font-light lining-nums tabular-nums sm:text-5xl" data-unidad={clave}>--</span>
          <span class="text-[0.68rem] tracking-[0.24em] text-oliva uppercase">{texto}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.cuenta-atras').forEach((el) => {
    const fin = Date.parse(el.dataset.fin!);
    const textos = JSON.parse(el.dataset.textos!);
    const etiqueta = el.querySelector('.cuenta-atras-texto')!;
    const celdas = Object.fromEntries(
      [...el.querySelectorAll<HTMLElement>('[data-unidad]')].map((c) => [c.dataset.unidad, c]),
    );
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const ahora = Date.now();
      const terminado = ahora >= fin;
      const s = Math.max(0, Math.floor((fin - ahora) / 1000));
      etiqueta.textContent = terminado ? textos.despues : textos.durante;
      celdas.dias.textContent = pad(Math.floor(s / 86400));
      celdas.horas.textContent = pad(Math.floor((s % 86400) / 3600));
      celdas.min.textContent = pad(Math.floor((s % 3600) / 60));
      celdas.seg.textContent = pad(s % 60);
    };
    setInterval(tick, 1000);
    tick();
  });
</script>
