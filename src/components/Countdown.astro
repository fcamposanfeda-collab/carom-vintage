---
interface Props {
  fin: string;
}
const { fin } = Astro.props;
const unidades = [
  ['dias', 'días'],
  ['horas', 'horas'],
  ['min', 'min'],
  ['seg', 'seg'],
];
---
<div class="cuenta-atras" data-fin={fin} role="timer" aria-label="Tiempo restante de la promoción">
  <ul class="flex gap-3 sm:gap-4">
    {unidades.map(([clave, texto]) => (
      <li class="flex min-w-16 flex-col items-center rounded-lg border border-crema/25 px-3 py-3 sm:min-w-20">
        <span class="font-serif text-4xl leading-none tabular-nums sm:text-5xl" data-unidad={clave}>--</span>
        <span class="mt-1.5 text-[0.7rem] tracking-[0.2em] uppercase opacity-80">{texto}</span>
      </li>
    ))}
  </ul>
  <p class="cuenta-atras-fin mt-3 hidden text-sm">La promoción ha terminado. ¡Escríbenos y te avisamos de la próxima!</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.cuenta-atras').forEach((el) => {
    const fin = new Date(el.dataset.fin!).getTime();
    const celdas = Object.fromEntries(
      [...el.querySelectorAll<HTMLElement>('[data-unidad]')].map((c) => [c.dataset.unidad, c]),
    );
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const resto = Math.max(0, fin - Date.now());
      const s = Math.floor(resto / 1000);
      celdas.dias.textContent = pad(Math.floor(s / 86400));
      celdas.horas.textContent = pad(Math.floor((s % 86400) / 3600));
      celdas.min.textContent = pad(Math.floor((s % 3600) / 60));
      celdas.seg.textContent = pad(s % 60);
      if (resto === 0) {
        el.querySelector('.cuenta-atras-fin')?.classList.remove('hidden');
        clearInterval(timer);
      }
    };
    const timer = setInterval(tick, 1000);
    tick();
  });
</script>
