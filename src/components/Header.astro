---
import Logo from './Logo.astro';
import IconInstagram from './IconInstagram.astro';
import { site, contactoLink } from '../data/site';
import { blackFriday as bf } from '../data/blackfriday';

const enlaces = [
  { href: '/#novedades', texto: 'Novedades' },
  { href: '/#coleccion', texto: 'Selección de piezas' },
  { href: '/#jackets', texto: 'The Jacket Edit' },
  { href: '/#tarjeta-regalo', texto: 'The gift card' },
  { href: '/#nosotros', texto: 'Nosotros' },
  { href: '/#faq', texto: 'Faq' },
];
---
<p class="bg-oliva px-4 py-2.5 text-center text-[0.62rem] tracking-[0.2em] text-crema uppercase sm:text-xs sm:tracking-[0.24em]">
  {bf.activo ? `Acceso privado · ${bf.fechasTexto}` : 'Piezas únicas · Envíos a toda España'}
</p>

<header class="sticky top-0 z-20 border-b border-oliva/15 bg-white text-oliva">
  <div class="contenedor grid grid-cols-[44px_1fr_44px] items-center gap-5 py-2 md:py-5">
    <button
      id="boton-menu"
      type="button"
      class="flex h-11 w-11 items-center justify-center"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
    </button>

    <a href="/" aria-label={`${site.nombre}, ir al inicio`} class="justify-self-center">
      <Logo class="origin-center scale-[0.78] text-oliva md:scale-100" />
    </a>

    <a
      href={contactoLink()}
      target="_blank"
      rel="noopener"
      aria-label={`Escribir un mensaje directo a ${site.instagramUsuario}`}
      class="flex h-11 w-11 items-center justify-center justify-self-end transition-colors hover:text-oliva/70"
      data-umami-event="instagram-md-click"
      data-umami-event-origen="cabecera"
    >
      <IconInstagram class="h-5 w-5" />
    </a>
  </div>

  <nav id="menu-principal" aria-label="Menú principal" class="hidden flex-col border-t border-oliva/15 bg-white px-6 pt-2 pb-6">
    {enlaces.map((e) => (
      <a href={e.href} class="etiqueta flex min-h-11 items-center text-sm tracking-[0.2em] transition-colors hover:text-oliva/70">
        {e.texto}
      </a>
    ))}
  </nav>
</header>

<script>
  const boton = document.getElementById('boton-menu')!;
  const menu = document.getElementById('menu-principal')!;
  const abrir = (abierto: boolean) => {
    menu.classList.toggle('hidden', !abierto);
    menu.classList.toggle('flex', abierto);
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  };
  boton.addEventListener('click', () => abrir(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrir(false)));
</script>
