---
import Logo from './Logo.astro';
import IconInstagram from './IconInstagram.astro';
import { site, whatsappLink } from '../data/site';
---
<header class="contenedor flex flex-col items-center gap-6 pt-8 pb-4 sm:grid sm:grid-cols-[1fr_auto_1fr] sm:gap-0 sm:pt-9">
  <a href="/" aria-label={`${site.nombre}, ir al inicio`} class="sm:col-start-2 sm:row-start-1">
    <Logo />
  </a>

  <nav aria-label="Principal" class="etiqueta flex gap-8 sm:col-start-1 sm:row-start-1">
    <a href="/#coleccion" class="transition-opacity hover:opacity-60">Colección</a>
    <a href="/#nosotros" class="transition-opacity hover:opacity-60">Nosotros</a>
    <a
      href={whatsappLink()}
      target="_blank"
      rel="noopener"
      class="transition-opacity hover:opacity-60 sm:hidden"
      data-umami-event="whatsapp-click"
      data-umami-event-origen="cabecera"
    >
      Contacto
    </a>
  </nav>

  <div class="etiqueta hidden items-center justify-end gap-8 sm:col-start-3 sm:row-start-1 sm:flex">
    <a
      href={whatsappLink()}
      target="_blank"
      rel="noopener"
      class="transition-opacity hover:opacity-60"
      data-umami-event="whatsapp-click"
      data-umami-event-origen="cabecera"
    >
      Contacto
    </a>
    <a
      href={site.instagram}
      target="_blank"
      rel="noopener"
      aria-label={`Instagram ${site.instagramUsuario}`}
      class="transition-opacity hover:opacity-60"
      data-umami-event="instagram-click"
      data-umami-event-origen="cabecera"
    >
      <IconInstagram class="h-5 w-5" />
    </a>
  </div>
</header>
